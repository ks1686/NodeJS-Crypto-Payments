STELLAR_WALLET_ADDRESS=
ETHEREUM_WALLET_ADDRESS=
ETHERSCAN_API_KEY=

# Optional — testnet defaults shown
STELLAR_EXPLORER=https://horizon-testnet.stellar.org
ETHEREUM_EXPLORER=https://api-sepolia.etherscan.io/api
NETWORK=testnet
ALLOW_MAINNET=false
PORT=8000
PAYMENT_TTL_MS=300000
ETH_AMOUNT_WEI=100000000000000000
XLM_AMOUNT_STROOPS=300000000
ETH_CONFIRMATIONS=1

# Save invoices across restarts (recommended for demos)
DATA_FILE=./data/invoices.json

# Zero-config demo (no keys, no testnet): `npm run demo`
# uses .env.demo values automatically — no need to set anything here.

# Zero-config demo profile used by `npm run demo`.
# Both chains point at the bundled mock explorer (scripts/demo.js sets this up),
# invoices persist to ./data/, and no real keys or funds are involved.
STELLAR_WALLET_ADDRESS=GDEMOACCOUNT11111111111111111111111111111111111111111111
ETHEREUM_WALLET_ADDRESS=0xdemo00000000000000000000000000000000c0ffee
ETHERSCAN_API_KEY=demo-key-not-real
STELLAR_EXPLORER=http://127.0.0.1:4311
ETHEREUM_EXPLORER=http://127.0.0.1:4311/api
NETWORK=testnet
DATA_FILE=./data/demo-invoices.json

<%- include("partials/header", { title }) %>
    <main class="container">
      <img class="qr-code" src="<%= qrDataUrl %>" alt="Payment QR code" />

      <section class="pay-summary">
        <p class="pay-line">
          Send <strong id="amount"><%= displayAmount %> <%= unit %></strong> to
          <code class="destination" id="destination"><%= invoice.destination %></code>
        </p>
        <% if (invoice.memo) { %>
        <p class="pay-line">
          Memo (required):
          <strong class="memo" id="memo"><%= invoice.memo %></strong>
        </p>
        <% } %>

        <dl class="invoice-facts">
          <div>
            <dt>Invoice</dt>
            <dd><code><%= invoice.id %></code></dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd id="status" data-status="<%= invoice.status %>" data-invoice-id="<%= invoice.id %>" data-unit="<%= unit %>"><%= invoice.status %></dd>
          </div>
          <div>
            <dt>Received</dt>
            <dd id="received"><%= invoice.receivedAmount ?? "—" %> <%= unit %></dd>
          </div>
          <div>
            <dt>Expires</dt>
            <dd id="expires"><%= new Date(invoice.expiresAt).toISOString() %></dd>
          </div>
        </dl>
        <dl class="invoice-facts">
          <div>
            <dt>Invoice</dt>
            <dd><code><%= invoice.id %></code></dd>
          </div>
        </dl>
      </section>

      <div id="result" role="status"></div>
      <div id="success-message" role="status"></div>

      <p class="poll-note">Checking for payment automatically every few seconds.</p>
      <p><a href="/invoices">All invoices →</a></p>
    </main>
    <script src="/static/payment.js"></script>
<%- include("partials/footer") %>
